    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "You are an AI Recruitment Assistant.\n\nYour job is to help HR users manage candidates.\n\nYou have access to tools for:\n\n1. Searching candidates.\n2. Getting candidate details.\n3. Updating candidate status.\n4. Sending candidate emails.\n\nAlways choose the appropriate tool based on the user's request.\n\nDo not invent candidate information.\n\nWhen a specific candidate is mentioned, verify the candidate information using the database tools.\n\nBefore changing a candidate's status, verify the candidate and require human confirmation before executing the update.\n\nBefore sending an email, verify the candidate's email address and prepare the email content. The Gmail tool requires human approval before sending.\n\nIf a tool fails, clearly explain the problem and never claim that an action succeeded.\n\nFor search requests, return concise and accurate candidate information.\n\nBe professional and concise."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        144,
        -224
      ],
      "id": "0ef19d28-0324-4911-8b29-fbd54978fe38",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "modelName": "=models/gemini-3.5-flash-lite",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        96,
        208
      ],
      "id": "74a40fc7-dc0a-410f-8d39-519f68689295",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "DAGUSJSykLbGmxT9",
          "name": "Google Gemini(PaLM) Api account 2"
        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Search the candidates database by name, position, skills, or status.\n\nUse this tool when the user asks to find or search for candidates.",
        "operation": "executeQuery",
        "query": "SELECT id, name, email, position, skills, experience_years, status\nFROM candidates\nWHERE name ILIKE '%' || $1 || '%'\n   OR position ILIKE '%' || $1 || '%'\n   OR skills ILIKE '%' || $1 || '%'\n   OR status ILIKE '%' || $1 || '%'\nORDER BY experience_years DESC;",
        "options": {
          "queryReplacement": "={{ $fromAI('search_term', 'One keyword to search for, like Angular or Frontend', 'string') }}"
        }
      },
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.7,
      "position": [
        560,
        176
      ],
      "id": "4fbdf097-29b2-4729-9ca3-d86034834bc7",
      "name": "search_candidates",
      "notesInFlow": false,
      "credentials": {
        "postgres": {
          "id": "kucQ917z6tKZodju",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Get complete information about one candidate by candidate ID or exact email.\n\nUse this tool when the user asks for details about a specific candidate.",
        "operation": "executeQuery",
        "query": "SELECT id, name, email, phone, position, skills, experience_years, status, created_at\nFROM candidates\nWHERE id = $1;",
        "options": {
          "queryReplacement": "={{ $fromAI('candidate_id', 'The numeric candidate ID', 'number') }}"
        }
      },
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.7,
