        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Update the status of a candidate.\n\nAllowed statuses:\nnew\nscreening\ninterview\nrejected\nhired\n\nOnly use this tool after the user confirms the action.",
        "operation": "executeQuery",
        "query": "UPDATE candidates\nSET status = $2\nWHERE id = $1\nRETURNING id, name, email, status;",
        "options": {
          "queryReplacement": "={{ $fromAI('candidate_id', 'The numeric candidate ID', 'number') }}, {{ $fromAI('new_status', 'One of: new, screening, interview, rejected, hired', 'string') }}"
        }
      },
      "type": "n8n-nodes-base.postgresTool",
